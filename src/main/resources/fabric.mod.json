{
	"schemaVersion": 1,
	"id": "rpgclassselection",
	"version": "${version}",
	"name": "RPG Class Selection",
	"description": "Adds a class selection screen known from many RPGs.",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/rpg-class-selection"
	},
	"license": "MIT",
	"icon": "assets/rpgclassselection/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.rpgclassselection.RPGClassSelection"
		],
		"client": [
			"com.github.theredbrain.rpgclassselection.RPGClassSelectionClient"
		]
	},
	"mixins": [
		"rpgclassselection.mixins.json",
		{
			"config": "rpgclassselection.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"fabric-api": "*",
		"spell_engine": ">=${spell_engine_version}",
		"fzzy_config": ">=${fzzy_config_version}",
		"rpginventory": ">=${rpg_inventory_version}"
	}
}